{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunatv-workers-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "limits": {
    "cpu_ms": 10,
    "subrequests": 50
  },
  "vars": {
    "USERNAME": "IceDcap",
    "NEXT_PUBLIC_STORAGE_TYPE": "d1",
    "NEXT_PUBLIC_SITE_NAME": "LunaTV Workers Test",
    "NEXT_PUBLIC_SEARCH_MAX_PAGE": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunatv-workers-test",
      "database_id": "3f1325f5-6331-46ed-b2cf-35e8dca18b51",
      "migrations_dir": "migrations"
    }
  ],
  "keep_names": false
}
