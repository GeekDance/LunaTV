// Dedicated real Free account. Free CPU/query limits are enforced by the platform.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunatv-free-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "USERNAME": "IceDcap",
    "NEXT_PUBLIC_STORAGE_TYPE": "d1",
    "NEXT_PUBLIC_SITE_NAME": "LunaTV Workers Test",
    "NEXT_PUBLIC_SEARCH_MAX_PAGE": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunatv-free-test",
      "database_id": "e29d4bf3-0088-4e54-93eb-c96a5f43c5cd",
      "migrations_dir": "migrations"
    }
  ],
  "keep_names": false,
  "account_id": "a4b909fc770c81031dd1f17517b5aec6"
}
